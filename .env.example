# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# (hex avoids characters that would break the database/redis URLs)

# ── Public hostname (Caddy obtains a Let's Encrypt cert for it) ──────────────
DOMAIN=waf.example.com

# ── Secrets ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Used by log shippers → X-API-Key header on POST /api/logs/ingest
INGEST_API_KEY=
# Used to sign in to the dashboard (must differ from the ingest key)
DASHBOARD_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Only needed if another origin calls the API from a browser
CORS_ORIGINS=
ENABLE_DOCS=false
RETENTION_DAYS=30
BACKUP_KEEP_DAYS=7
WEB_CONCURRENCY=4
LOG_LEVEL=INFO

# ── Detection tuning (weights must sum to 1.0) ───────────────────────────────
# THREAT_SCORE_LOW=0.30
# THREAT_SCORE_MEDIUM=0.60
# THREAT_SCORE_HIGH=0.85
# RULE_WEIGHT=0.45
# ISOLATION_FOREST_WEIGHT=0.20
# RANDOM_FOREST_WEIGHT=0.35
# AUTOENCODER_WEIGHT=0.0
